# --- LLM / Embeddings provider ---
OPENAI_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHAT_MODEL=gpt-4o-mini

# --- Database (SQL metadata store) ---
# Defaults to local SQLite; swap for Postgres in production:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/palmmind
DATABASE_URL=sqlite:///./palmmind.db

# --- Vector store (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=palmmind_documents

# --- Redis (chat memory) ---
REDIS_URL=redis://localhost:6379/0
CHAT_MEMORY_TTL_SECONDS=86400
CHAT_MEMORY_MAX_TURNS=20

# --- Chunking defaults ---
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=120

# --- RAG ---
RAG_TOP_K=4
